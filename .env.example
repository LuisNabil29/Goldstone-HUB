# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/goldstone_hub"

# NextAuth / Auth.js
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
AUTH_URL="http://localhost:3040"
NEXTAUTH_URL="http://localhost:3040"

# Storage
STORAGE_PROVIDER="local"
UPLOAD_PATH="./uploads"

# SMTP — if empty, magic links are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GoldStone Hub <noreply@goldstonehub.local>"
